PORT=3000
NODE_ENV=development

# Database Settings
MONGODB_CONNECTION_STRING=mongodb://localhost:27017
MONGODB_DB_NAME=infinite7_impex

# Email Notification Settings (Resend HTTP API for cloud hosting like Render; SMTP for local)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM="Infinite 7 Impex" <onboarding@resend.dev>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Infinite 7 Impex" <infinite7impex@gmail.com>
NOTIFICATION_EMAIL=infinite7impex@gmail.com
ADMIN_EMAIL=infinite7impex@gmail.com

# Admin Authentication Settings
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h

# Global Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# CORS Allowed Origins (Comma-separated for custom domains)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Cloudinary Media Storage Settings
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=